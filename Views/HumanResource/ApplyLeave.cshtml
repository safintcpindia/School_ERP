@model SchoolERP.Net.Models.HRApplyLeavePageViewModel
@{
    ViewData["Title"] = "Apply Leave";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h6 class="fw-bold mb-0">Apply Leave</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        <button type="button" class="btn btn-primary d-inline-flex align-items-center" onclick="openAddModal()">
            <i class="ti ti-plus me-1"></i>Apply Leave
        </button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-tbl">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Staff</th>
                                <th>Leave Type</th>
                                <th>Leave Date</th>
                                <th>Days</th>
                                <th>Apply Date</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Leaves != null && Model.Leaves.Any())
                            {
                                foreach (var item in Model.Leaves)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle me-2">
                                                    @(item.StaffName?.Substring(0, 1).ToUpper() ?? "S")
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@item.StaffName</div>
                                                    <div class="small text-muted">@item.StaffCode</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-info-subtle text-info">@item.LeaveTypeName</span></td>
                                        <td>
                                            <div class="small">
                                                <i class="ti ti-calendar-event text-muted me-1"></i>
                                                @item.FromDate.ToString("dd MMM yyyy") - @item.ToDate.ToString("dd MMM yyyy")
                                            </div>
                                        </td>
                                        <td>@((item.ToDate - item.FromDate).Days + 1)</td>
                                        <td>@item.ApplyDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @{
                                                var badgeClass = item.Status == "Approved" ? "bg-success" : (item.Status == "Disapproved" ? "bg-danger" : "bg-warning");
                                            }
                                            <span class="badge @badgeClass">@item.Status</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-icon border-0" data-bs-toggle="dropdown">
                                                    <i class="ti ti-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="editLeave(@item.ApplyLeaveID)"><i class="ti ti-pencil me-2"></i>Edit</a></li>
                                                    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteLeave(@item.ApplyLeaveID)"><i class="ti ti-trash me-2"></i>Delete</a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <img src="https://mybeautyparlour.com/assets/frontend/images/no-record-found.png" width="150" alt="No Record">
                                        <p class="text-muted mt-2">No leave applications found.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Leave Modal -->
<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Apply Leave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="leaveForm">
                <div class="modal-body">
                    <input type="hidden" id="hdnApplyLeaveID" value="0" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Staff <span class="text-danger">*</span></label>
                            <select id="ddlStaff" class="form-select select2" required>
                                <option value="">Select Staff</option>
                                @foreach (var s in Model.StaffList)
                                {
                                    <option value="@s.StaffID">@s.FirstName @s.LastName (@s.StaffCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Leave Type <span class="text-danger">*</span></label>
                            <select id="ddlLeaveType" class="form-select select2" required>
                                <option value="">Select Type</option>
                                @foreach (var lt in Model.LeaveTypes)
                                {
                                    <option value="@lt.LeaveTypeID">@lt.LeaveTypeName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Leave From Date <span class="text-danger">*</span></label>
                            <input type="date" id="txtFromDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Leave To Date <span class="text-danger">*</span></label>
                            <input type="date" id="txtToDate" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Reason</label>
                            <textarea id="txtReason" class="form-control" rows="3" placeholder="Enter reason for leave..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <select id="ddlStatus" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Disapproved">Disapproved</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Attachment</label>
                            <input type="file" id="fileAttachment" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Admin Note</label>
                            <textarea id="txtNote" class="form-control" rows="2" placeholder="Internal remarks..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveLeave()">
                        <i class="ti ti-device-floppy me-1"></i>Save Application
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                dropdownParent: $('#leaveModal'),
                width: '100%'
            });
        });

        function openAddModal() {
            $('#modalTitle').text('Apply Leave');
            $('#hdnApplyLeaveID').val(0);
            $('#leaveForm')[0].reset();
            $('#ddlStaff').val('').trigger('change');
            $('#ddlLeaveType').val('').trigger('change');
            $('#ddlStatus').val('Pending');
            $('#leaveModal').modal('show');
        }

        async function editLeave(id) {
            try {
                const response = await fetch(`/api/HumanResourceApi/GetApplyLeaveByID/${id}`);
                const res = await response.json();
                if (res.success) {
                    const data = res.data;
                    $('#modalTitle').text('Edit Leave Application');
                    $('#hdnApplyLeaveID').val(data.applyLeaveID);
                    $('#ddlStaff').val(data.staffID).trigger('change');
                    $('#ddlLeaveType').val(data.leaveTypeID).trigger('change');
                    $('#txtFromDate').val(data.fromDate.split('T')[0]);
                    $('#txtToDate').val(data.toDate.split('T')[0]);
                    $('#txtReason').val(data.reason);
                    $('#ddlStatus').val(data.status);
                    $('#txtNote').val(data.note);
                    $('#leaveModal').modal('show');
                } else {
                    alert(res.message);
                }
            } catch (error) {
                console.error('Error fetching leave details:', error);
            }
        }

        async function saveLeave() {
            const form = document.getElementById('leaveForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const fileEl = document.getElementById('fileAttachment');
            const file = fileEl.files[0];
            let attachmentBase64 = null;
            let docType = null;
            let docName = null;

            if (file) {
                docType = file.type;
                docName = file.name;
                attachmentBase64 = await new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.readAsDataURL(file);
                });
            }

            const data = {
                applyLeaveID: parseInt($('#hdnApplyLeaveID').val()),
                staffID: parseInt($('#ddlStaff').val()),
                leaveTypeID: parseInt($('#ddlLeaveType').val()),
                fromDate: $('#txtFromDate').val(),
                toDate: $('#txtToDate').val(),
                reason: $('#txtReason').val(),
                status: $('#ddlStatus').val(),
                note: $('#txtNote').val(),
                attachmentBase64: attachmentBase64,
                attachmentDocType: docType,
                attachmentDocName: docName
            };

            try {
                const response = await fetch('/api/HumanResourceApi/UpsertApplyLeave', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            } catch (error) {
                console.error('Error saving leave:', error);
            }
        }

        async function deleteLeave(id) {
            if (!confirm('Are you sure you want to delete this leave application?')) return;
            try {
                const response = await fetch(`/api/HumanResourceApi/DeleteApplyLeave/${id}`, { method: 'POST' });
                const res = await response.json();
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            } catch (error) {
                console.error('Error deleting leave:', error);
            }
        }
    </script>
}
